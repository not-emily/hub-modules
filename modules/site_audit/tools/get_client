#!/usr/bin/env python3
"""site_audit.get_client -- one audit client in full, page list included.

The shape returned here is what a workflow translates into crawl vocabulary, so
it holds nothing audit-shaped the crawler would have to ignore.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

import siteaudit as sa

values = sa.params()
slug, record = sa.resolve_client(sa.client_identifier(values))

record.setdefault("pages", [])

sa.ok(slug=slug, client=record, file=str(sa.client_path(slug)))
